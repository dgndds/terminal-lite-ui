{
  "name": "terminal-lite",
  "version": "0.0.30",
  "description": "A lightweight customizable terminal-like React component.",
  "main": "dist/cjs/Terminal.js",
  "exports": {
    ".": {
      "import": "./dist/esm/Terminal.js",
      "require": "./dist/cjs/Terminal.js",
      "types": "./dist/types/Terminal.d.ts",
      "css": "./dist/styles.css"
    },
    "./styles.css": "./dist/styles.css",
    "./css": "./dist/styles.css"
  },
  "types": "dist/types/Terminal.d.ts",
  "files": [
    "dist/styles.css",
    "dist"
  ],
  "scripts": {
    "build": "tsc --module ESNext --outDir dist/esm && tsc --module CommonJS --outDir dist/cjs",
    "build:css": "postcss styles.css -o dist/styles.css",
    "build:all": "npm run build && npm run build:css"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.3",
    "@types/node": "^22.14.0",
    "@types/react": "^17.0.85",
    "@types/react-dom": "^17.0.26",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.3",
    "typescript": "^4.4.0"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.0.1",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "postcss-cli": "^11.0.1",
    "tailwind-merge": "^3.2.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dgndds/terminal-lite-ui"
  },
  "keywords": [
    "terminal",
    "react",
    "component",
    "lightweight",
    "customizable",
    "terminal-like"
  ],
  "author": "Muhammed Doğancan Yılmazoğlu"
}
